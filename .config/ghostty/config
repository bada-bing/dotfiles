font-size = 19
# Disable all ligatures so every character renders distinctly
font-feature = "-liga"
font-feature = "-dlig"
font-feature = "-calt"

theme = "TokyoNight Night"
background-opacity = 1.0

window-colorspace = display-p3

macos-titlebar-style = tabs
macos-option-as-alt = true

confirm-close-surface = false

# Drop to login shell after tmux exits
command = /bin/bash -lc "~/.config/ghostty/attachTmux.sh; exec -l $SHELL"


keybind = shift+enter=text:\x1b\r
keybind = global:cmd+shift+ctrl+alt+i=toggle_quick_terminal
quick-terminal-size = 40%
quick-terminal-position = top
quick-terminal-animation-duration = 0.1
